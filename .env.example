# Google Earth Engine
EE_PROJECT_ID=
SATELLITE_PROVIDER=demo
AOI_PATH=data/aoi/sundarbans_transboundary_envelope.geojson
MIN_VALID_PIXEL_FRACTION=0.30

# Database
DATABASE_URL=sqlite:///data/mangrove_guardian.db

# Web application
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_SCHEDULER=true
ENABLE_EXTERNAL_NOTIFICATIONS=false
REQUIRE_ALERT_APPROVAL=true
AUTO_EMAIL_REPORTS=true
AUTO_APPROVE_VALIDATED_MODELS=false
ENABLE_AUTOMATED_RETRAINING=true
REPORT_IMAGE_DIMENSIONS=1800
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
API_KEY=
POSTGRES_PASSWORD=change-me-for-deployment


