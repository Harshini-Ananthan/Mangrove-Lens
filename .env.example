# Google Earth Engine
EE_PROJECT_ID=nex-sync
SATELLITE_PROVIDER=demo
AOI_PATH=data/aoi/sundarbans_transboundary_envelope.geojson
MIN_VALID_PIXEL_FRACTION=0.30

# Database
DATABASE_URL=sqlite:///data/mangrove_guardian.db

# Web application
CORS_ORIGINS=http://localhost:5173
ENABLE_SCHEDULER=false
ENABLE_EXTERNAL_NOTIFICATIONS=false
REQUIRE_ALERT_APPROVAL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
API_KEY=
POSTGRES_PASSWORD=change-me-for-deployment

# Other API Keys (Future use)
# OPENAI_API_KEY=your-openai-api-key
